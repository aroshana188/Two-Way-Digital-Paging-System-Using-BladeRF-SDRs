- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nfrom Crypto.Cipher\
      \ import AES\nfrom Crypto.Util import Counter\n\nclass aes_encrypt_pdu(gr.basic_block):\n\
      \    def __init__(self, key_str='1234567890123456', log_file=''):\n        gr.basic_block.__init__(self,\n\
      \            name=\"AES Encrypt PDU\",\n            in_sig=None,\n         \
      \   out_sig=None)\n\n        self.message_port_register_in(pmt.intern(\"pdu_in\"\
      ))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n       \
      \ # AES CONFIG\n        # Key must be exactly 16, 24, or 32 bytes\n        self.key\
      \ = key_str.encode('utf-8')\n        \n        # LOGGING\n        self.log_file_path\
      \ = log_file\n\n    def log(self, msg):\n        print(msg)\n        if self.log_file_path\
      \ != '':\n            try:\n                with open(self.log_file_path, 'a')\
      \ as f:\n                    f.write(f\"{msg}\\n\")\n            except: pass\n\
      \n    def handle_msg(self, msg):\n        try:\n            payload_pmt = pmt.cdr(msg)\n\
      \            data_list = pmt.u8vector_elements(payload_pmt)\n            \n\
      \            if len(data_list) < 2: return\n\n            # 1. Separate Seq\
      \ Num from Data\n            # Byte 0 is Sequence Number. We DO NOT encrypt\
      \ this so ARQ still works.\n            seq_num = data_list[0]\n           \
      \ raw_data = bytes(data_list[1:])\n            \n            # 2. Create AES\
      \ Cipher\n            # We use the SeqNum to create a unique counter for every\
      \ packet.\n            # This is critical for security (prevents \"Two Time\
      \ Pad\" attack).\n            # initial_value must be integer.\n           \
      \ ctr = Counter.new(128, initial_value=seq_num + 1) \n            cipher = AES.new(self.key,\
      \ AES.MODE_CTR, counter=ctr)\n            \n            # 3. Encrypt Payload\n\
      \            encrypted_bytes = cipher.encrypt(raw_data)\n            \n    \
      \        # 4. Rebuild PDU: [Seq Num] + [Encrypted Data]\n            out_list\
      \ = [seq_num] + list(encrypted_bytes)\n            out_vec = pmt.init_u8vector(len(out_list),\
      \ out_list)\n            out_msg = pmt.cons(pmt.PMT_NIL, out_vec)\n        \
      \    \n            self.message_port_pub(pmt.intern(\"pdu_out\"), out_msg)\n\
      \n        except Exception as e:\n            self.log(f\"[AES Encrypt Error]\
      \ {e}\")"
    affinity: ''
    alias: ''
    comment: ''
    key_str: '''1234567890123456'''
    log_file: '"C:/Users/PC/Desktop/Transmitter log.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('AES Encrypt PDU', 'aes_encrypt_pdu', [('key_str', "'1234567890123456'"),
      ('log_file', "''")], [('pdu_in', 'message', 1)], [('pdu_out', 'message', 1)],
      '', [])
    bus_sink: false
