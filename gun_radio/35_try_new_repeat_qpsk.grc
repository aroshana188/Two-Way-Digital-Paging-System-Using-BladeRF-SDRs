- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: File Source PDU (Corrected for 1-Byte\
      \ SN)\n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ threading\nimport time\nimport struct\nimport os\n\nclass file_source_pdu(gr.basic_block):\n\
      \    def __init__(self, filename='message.txt', pdu_size=64, delay=0.05):\n\
      \        \"\"\"\n        Args:\n            filename: Path to the text file.\n\
      \            pdu_size: Total size of the output PDU in bytes.\n            delay:\
      \ Time delay between sending PDUs.\n        \"\"\"\n        gr.basic_block.__init__(self,\n\
      \            name=\"File Source PDU\",\n            in_sig=None,\n         \
      \   out_sig=None)\n\n        self.message_port_register_out(pmt.intern('pdu_out'))\n\
      \n        self.filename = filename\n        self.pdu_size = pdu_size\n     \
      \   self.delay = delay\n        \n        # FIXED: Hardcoded to 1 byte because\
      \ your Receiver expects data_bytes[0] to be the SN\n        self.seq_len = 1\
      \ \n        self.payload_size = self.pdu_size - self.seq_len\n\n        self.stop_thread\
      \ = False\n        self.thread = threading.Thread(target=self.run)\n       \
      \ self.thread.daemon = True\n\n    def start(self):\n        self.stop_thread\
      \ = False\n        self.thread.start()\n        return True\n\n    def stop(self):\n\
      \        self.stop_thread = True\n        if self.thread.is_alive():\n     \
      \       self.thread.join()\n        return True\n\n    def run(self):\n    \
      \    time.sleep(1)\n        \n        if not os.path.exists(self.filename):\n\
      \            print(f\"[Error] File not found: {self.filename}\")\n         \
      \   return\n\n        with open(self.filename, 'rb') as f:\n            file_content\
      \ = f.read()\n\n        data = bytearray(file_content)\n        total_len =\
      \ len(data)\n        num_packets = (total_len + self.payload_size - 1) // self.payload_size\n\
      \        \n        print(f\"[File Source] Sending {total_len} bytes in {num_packets}\
      \ packets.\")\n\n        seq_num = 0\n        \n        for i in range(0, total_len,\
      \ self.payload_size):\n            if self.stop_thread:\n                break\n\
      \n            # 1. Slice the data\n            chunk = data[i : i + self.payload_size]\n\
      \            \n            # 2. Add Sequence Number (Header)\n            #\
      \ FIXED: 'B' packs it as a single unsigned byte (0-255)\n            # We use\
      \ % 256 to ensure it wraps around and doesn't crash if file is large\n     \
      \       header = struct.pack('B', seq_num % 256) \n            \n          \
      \  # 3. Add Padding (if needed)\n            current_len = len(chunk) + len(header)\n\
      \            padding_len = self.pdu_size - current_len\n            \n     \
      \       if padding_len > 0:\n                padding = b'\\x00' * padding_len\n\
      \                chunk = chunk + padding\n            \n            # Combine\n\
      \            full_packet = header + chunk\n            \n            # 4. Create\
      \ PDU\n            meta = pmt.make_dict()\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"seq_num\"), pmt.from_long(seq_num))\n            \n         \
      \   # Convert to PMT vector\n            pdu_vector = pmt.init_u8vector(len(full_packet),\
      \ list(full_packet))\n            pdu = pmt.cons(meta, pdu_vector)\n       \
      \     \n            # 5. Send\n            self.message_port_pub(pmt.intern('pdu_out'),\
      \ pdu)\n            \n            print(f\"[Sent] Seq: {seq_num % 256}, Size:\
      \ {len(full_packet)}\")\n            \n            seq_num += 1\n          \
      \  time.sleep(self.delay)"
    affinity: ''
    alias: ''
