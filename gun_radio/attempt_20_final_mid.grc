- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass AckNackGenerator(gr.basic_block):\n\
      \    \"\"\"\n    Simple ACK/NACK Generator.\n    - Receives messages on \"ok_in\"\
      \ or \"fail_in\".\n    - Outputs \"ack\" or \"nack\" symbols on \"out\".\n \
      \   Compatible with PDUFileSource's ctrl_in port.\n    \"\"\"\n\n    def __init__(self):\n\
      \        gr.basic_block.__init__(self, name=\"ACK/NACK Generator\", in_sig=[],\
      \ out_sig=[])\n\n        # Input ports\n        self.message_port_register_in(pmt.intern(\"\
      ok_in\"))\n        self.set_msg_handler(pmt.intern(\"ok_in\"), self.handle_ok)\n\
      \n        self.message_port_register_in(pmt.intern(\"fail_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      fail_in\"), self.handle_fail)\n\n        # Output port (to file source ctrl_in)\n\
      \        self.message_port_register_out(pmt.intern(\"out\"))\n\n    def handle_ok(self,\
      \ msg):\n        print(f\"[ACK/NACK] Sending ACK\")\n        self.message_port_pub(pmt.intern(\"\
      out\"), pmt.intern(\"ack\"))\n\n    def handle_fail(self, msg):\n        print(f\"\
      [ACK/NACK] Sending NACK\")\n        self.message_port_pub(pmt.intern(\"out\"\
      ), pmt.intern(\"nack\"))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('ACK/NACK Generator', 'AckNackGenerator', [], [('ok_in', 'message',
      1), ('fail_in', 'message', 1)], [('out', 'message', 1)], '\nSimple ACK/NACK
      Generator.\n- Receives messages on "ok_in" or "fail_in".\n- Outputs "ack" or
      "nack" symbols on "out".\nCompatible with PDUFileSource\'s ctrl_in port.\n',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3792, 808.0]
    rotation: 180
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass TaggedStreamToFile(gr.basic_block):\n\
      \    \"\"\"\n    Writes incoming PDUs (Tagged Stream converted to PDU) into\
      \ a file.\n    Ensures that \"CONNECTION_ESTABLISHED\" PDU is written only once,\n\
      \    followed by a newline to separate it from subsequent PDUs.\n    \"\"\"\n\
      \n    def __init__(self, filename=\"C:/Users/arosh/OneDrive/Desktop/output.txt\"\
      ):\n        gr.basic_block.__init__(\n            self,\n            name=\"\
      TaggedStreamToFile\",\n            in_sig=[],\n            out_sig=[]\n    \
      \    )\n        self.filename = filename\n        self.handshake_written = False\
      \  # Track if CONNECTION_ESTABLISHED has been written\n\n        # Register\
      \ message input port\n        self.message_port_register_in(pmt.intern(\"in\"\
      ))\n        self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n  \
      \  def handle_msg(self, msg):\n        # msg is a PDU = (metadata dict, data\
      \ vector)\n        if not pmt.is_pair(msg):\n            print(\"[WARNING] Received\
      \ invalid PDU\")\n            return\n\n        meta = pmt.car(msg)\n      \
      \  data = pmt.cdr(msg)\n\n        # Ensure data is a u8vector\n        if not\
      \ pmt.is_u8vector(data):\n            print(\"[WARNING] Received PDU with invalid\
      \ data type\")\n            return\n\n        # Convert data to Python bytes\n\
      \        data_bytes = bytes(pmt.u8vector_elements(data))\n\n        with open(self.filename,\
      \ \"ab\") as f:\n            # Handle handshake PDU\n            if data_bytes\
      \ == b\"CONNECTION_ESTABLISHED\":\n                if self.handshake_written:\n\
      \                    #print(\"[DEBUG] Handshake PDU received again, skipping\
      \ write\")\n                    return\n                else:\n            \
      \        self.handshake_written = True\n                    f.write(b\"\\n\\\
      n\" + data_bytes + b\"\\n\\n\")  # Add newline after handshake\n           \
      \         #print(\"[DEBUG] Handshake PDU written to file\")\n              \
      \      return\n\n            # Write normal PDU payloads\n            f.write(data_bytes)\n"
    affinity: ''
    alias: ''
    comment: ''
    filename: '"C:/Users/arosh/OneDrive/Desktop/output.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('TaggedStreamToFile', 'TaggedStreamToFile', [('filename', "'C:/Users/arosh/OneDrive/Desktop/output.txt'")],
      [('in', 'message', 1)], [], '\nWrites incoming PDUs (Tagged Stream converted
      to PDU) into a file.\nEnsures that "CONNECTION_ESTABLISHED" PDU is written only
      once,\nfollowed by a newline to separate it from subsequent PDUs.\n', ['filename'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4320, 640.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import os\nimport threading\nimport time\nfrom gnuradio import\
      \ gr\nimport pmt\n\nclass PDUFileSource(gr.basic_block):\n    \"\"\"\n    Reads\
      \ a text/binary file, splits into PDUs, and outputs them on demand.\n    - Sends\
      \ a CONNECTION_ESTABLISHED PDU first to establish the connection.\n    - Waits\
      \ for handshake ACK before sending actual data PDUs.\n    - After that, works\
      \ same as before:\n      - \"ack\" \u2192 advance to next PDU\n      - \"nack\"\
      \ or timeout \u2192 resend same PDU (up to max_retries times)\n      - Last\
      \ PDU is sent one extra time.\n    \"\"\"\n\n    def __init__(self, file_path=\"\
      \", chunk_size=256, max_retries=3, timeout_sec=1.0):\n        gr.basic_block.__init__(self,\
      \ name=\"PDU File Source\", in_sig=[], out_sig=[])\n\n        self.file_path\
      \ = file_path\n        self.chunk_size = chunk_size\n        self.max_retries\
      \ = max_retries\n        self.timeout_sec = timeout_sec\n\n        self.pdus\
      \ = []\n        self.index = 0\n        self.retry_count = 0\n        self.last_pdu_sent_once\
      \ = False\n\n        self.handshake_done = False\n\n        self._lock = threading.Lock()\n\
      \        self._timer_thread = None\n        self._timer_event = threading.Event()\n\
      \n        self._load_file()\n\n        # Output port for PDUs\n        self.message_port_register_out(pmt.intern(\"\
      pdus_out\"))\n\n        # Input port for ACK/NACK\n        self.message_port_register_in(pmt.intern(\"\
      ctrl_in\"))\n        self.set_msg_handler(pmt.intern(\"ctrl_in\"), self.handle_ack_nack)\n\
      \n        print(f\"[INFO] PDUFileSource initialized. {len(self.pdus)} PDUs loaded.\
      \ \"\n              f\"max_retries={self.max_retries}, timeout={self.timeout_sec}s\"\
      )\n\n    def start(self):\n        print(\"[INFO] Sending CONNECTION_ESTABLISHED\
      \ PDU on start\")\n        self._send_handshake()\n        return True\n\n \
      \   def _load_file(self):\n        if not os.path.exists(self.file_path):\n\
      \            print(f\"[ERROR] File not found: {self.file_path}\")\n        \
      \    return\n        with open(self.file_path, \"rb\") as f:\n            data\
      \ = f.read()\n        self.pdus = [data[i:i+self.chunk_size] for i in range(0,\
      \ len(data), self.chunk_size)]\n        print(f\"[INFO] Loaded {len(self.pdus)}\
      \ PDUs from file '{self.file_path}'.\")\n\n    def _send_handshake(self):\n\
      \        handshake_bytes = b\"CONNECTION_ESTABLISHED\"\n        #print(\"[DEBUG]\
      \ Sending CONNECTION_ESTABLISHED PDU\")\n        pmt_pdu = pmt.cons(pmt.PMT_NIL,\
      \ pmt.init_u8vector(len(handshake_bytes), list(handshake_bytes)))\n        self.message_port_pub(pmt.intern(\"\
      pdus_out\"), pmt_pdu)\n        self._start_timer()\n\n    def _send_current_pdu(self):\n\
      \        if not self.handshake_done:\n            print(\"[WARNING] Tried to\
      \ send PDU before handshake ACK\")\n            return\n\n        if 0 <= self.index\
      \ < len(self.pdus):\n            pdu = self.pdus[self.index]\n            print(f\"\
      [DEBUG] Sending PDU {self.index} (size {len(pdu)}) [retry={self.retry_count}]\"\
      )\n            pmt_pdu = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(pdu), list(pdu)))\n\
      \            self.message_port_pub(pmt.intern(\"pdus_out\"), pmt_pdu)\n    \
      \        self._start_timer()\n        elif self.index >= len(self.pdus) and\
      \ not self.last_pdu_sent_once:\n            last_pdu = self.pdus[-1]\n     \
      \       print(f\"[DEBUG] Sending last PDU {len(self.pdus)-1} one more time\"\
      )\n            pmt_pdu = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(last_pdu),\
      \ list(last_pdu)))\n            self.message_port_pub(pmt.intern(\"pdus_out\"\
      ), pmt_pdu)\n            self.last_pdu_sent_once = True\n            self._start_timer()\n\
      \        else:\n            print(\"[INFO] No more PDUs to send. Flow finished.\"\
      )\n            time.sleep(1)\n\n    def _start_timer(self):\n        if self._timer_thread\
      \ and self._timer_thread.is_alive():\n            self._timer_event.set()\n\
      \            if threading.current_thread() != self._timer_thread:\n        \
      \        self._timer_thread.join()\n        self._timer_event.clear()\n    \
      \    self._timer_thread = threading.Thread(target=self._timeout_handler)\n \
      \       self._timer_thread.daemon = True\n        self._timer_thread.start()\n\
      \n    def _timeout_handler(self):\n        if not self._timer_event.wait(self.timeout_sec):\n\
      \            with self._lock:\n                if not self.handshake_done:\n\
      \                    print(\"[DEBUG] Timeout waiting for CONNECTION_ESTABLISHED\
      \ ACK, resending\")\n                    self._send_handshake()\n          \
      \          return\n                if self.index < len(self.pdus) or (self.index\
      \ >= len(self.pdus) and not self.last_pdu_sent_once):\n                    if\
      \ self.retry_count < self.max_retries:\n                        self.retry_count\
      \ += 1\n                        print(f\"[DEBUG] Timeout: resending PDU {self.index}\
      \ \"\n                              f\"(retry {self.retry_count}/{self.max_retries})\"\
      )\n                        self._send_current_pdu()\n                    else:\n\
      \                        print(f\"[WARNING] Max retries reached for PDU {self.index}.\
      \ Skipping to next.\")\n                        self.index += 1\n          \
      \              self.retry_count = 0\n                        self._send_current_pdu()\n\
      \n    def handle_ack_nack(self, msg_pmt):\n        if not pmt.is_symbol(msg_pmt):\n\
      \            print(\"[WARNING] Invalid control message format. Ignored.\")\n\
      \            return\n        command = pmt.symbol_to_string(msg_pmt).lower()\n\
      \n        with self._lock:\n            # Stop timer\n            if self._timer_thread\
      \ and self._timer_thread.is_alive():\n                self._timer_event.set()\n\
      \                if threading.current_thread() != self._timer_thread:\n    \
      \                self._timer_thread.join()\n\n            if not self.handshake_done:\n\
      \                if command == \"ack\":\n                    print(\"[INFO]\
      \ Handshake ACK received. Starting data transmission.\")\n                 \
      \   self.handshake_done = True\n                    self.index = 0\n       \
      \             self.retry_count = 0\n                    self._send_current_pdu()\n\
      \                else:\n                    print(f\"[WARNING] Expected handshake\
      \ ACK but got '{command}'\")\n                return\n\n            if command\
      \ == \"ack\":\n                self.index += 1\n                self.retry_count\
      \ = 0\n                if self.index < len(self.pdus):\n                   \
      \ self._send_current_pdu()\n                elif self.index >= len(self.pdus)\
      \ and not self.last_pdu_sent_once:\n                    last_pdu = self.pdus[-1]\n\
      \                    print(f\"[DEBUG] Sending END CONNECTION\")\n          \
      \          pmt_pdu = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(last_pdu),\
      \ list(last_pdu)))\n                    self.message_port_pub(pmt.intern(\"\
      pdus_out\"), pmt_pdu)\n                    self.last_pdu_sent_once = True\n\
      \                    self._start_timer()\n                else:\n          \
      \          print(\"[INFO] All PDUs sent and acknowledged. Flow finished.\")\n\
      \                    return\n            elif command == \"nack\":\n       \
      \         if self.retry_count < self.max_retries:\n                    self.retry_count\
      \ += 1\n                    print(f\"[DEBUG] NACK received: resending PDU {self.index}\
      \ \"\n                          f\"(retry {self.retry_count}/{self.max_retries})\"\
      )\n                    self._send_current_pdu()\n                else:\n   \
      \                 print(f\"[WARNING] Max retries reached for PDU {self.index}.\
      \ Skipping to next.\")\n                    self.index += 1\n              \
      \      self.retry_count = 0\n                    self._send_current_pdu()\n\
      \            else:\n                print(f\"[WARNING] Unknown control command:\
      \ {command}\")\n"
    affinity: ''
    alias: ''
    chunk_size: '256'
    comment: ''
    file_path: '"C:/Users/arosh/OneDrive/Desktop/GNU transmit.txt"'
    max_retries: '3'
    maxoutbuf: '0'
    minoutbuf: '0'
    timeout_sec: '3'
  states:
    _io_cache: "('PDU File Source', 'PDUFileSource', [('file_path', \"''\"), ('chunk_size',\
      \ '256'), ('max_retries', '3'), ('timeout_sec', '1.0')], [('ctrl_in', 'message',\
      \ 1)], [('pdus_out', 'message', 1)], '\\nReads a text/binary file, splits into\
      \ PDUs, and outputs them on demand.\\n- Sends a CONNECTION_ESTABLISHED PDU first\
      \ to establish the connection.\\n- Waits for handshake ACK before sending actual\
      \ data PDUs.\\n- After that, works same as before:\\n  - \"ack\" \u2192 advance\
      \ to next PDU\\n  - \"nack\" or timeout \u2192 resend same PDU (up to max_retries\
      \ times)\\n  - Last PDU is sent one extra time.\\n', ['chunk_size', 'file_path',\
      \ 'max_retries', 'timeout_sec'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 76.0]
    rotation: 0
    state: enabled
- name: epy_block_4
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass AckNackToPDU(gr.basic_block):\n\
      \    \"\"\"\n    Converts incoming messages ('ack'/'nack') into PDUs.\n    Output\
      \ PDU format: (metadata dict, u8vector of ASCII bytes)\n    \"\"\"\n\n    def\
      \ __init__(self):\n        gr.basic_block.__init__(self,\n            name=\"\
      Ack/Nack to PDU\",\n            in_sig=[],\n            out_sig=[]\n       \
      \ )\n\n        # Input message port\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n\
      \        # Output PDU port\n        self.message_port_register_out(pmt.intern(\"\
      pdus_out\"))\n\n    def handle_msg(self, msg):\n        if not pmt.is_symbol(msg):\n\
      \            print(\"[ERROR] Received non-symbol message. Ignored.\")\n    \
      \        return\n\n        msg_str = pmt.symbol_to_string(msg).lower()\n   \
      \     if msg_str not in (\"ack\", \"nack\"):\n            print(f\"[WARNING]\
      \ Unknown message '{msg_str}' received. Ignored.\")\n            return\n\n\
      \        # Convert to u8vector\n        data_bytes = [ord(c) for c in msg_str]\n\
      \        pdu = pmt.cons(pmt.make_dict(), pmt.init_u8vector(len(data_bytes),\
      \ data_bytes))\n\n        self.message_port_pub(pmt.intern(\"pdus_out\"), pdu)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''Ack/Nack to PDU'', ''AckNackToPDU'', [], [(''in'', ''message'',
      1)], [(''pdus_out'', ''message'', 1)], "\nConverts incoming messages (''ack''/''nack'')
      into PDUs.\nOutput PDU format: (metadata dict, u8vector of ASCII bytes)\n",
      [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3544, 824.0]
    rotation: 180
    state: enabled
- name: epy_block_5
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass PDUToAckNack(gr.basic_block):\n\
      \    \"\"\"\n    Converts incoming PDUs into 'ack' or 'nack' symbols.\n    Input\
      \ PDU format: (metadata dict, u8vector of ASCII bytes)\n    \"\"\"\n\n    def\
      \ __init__(self):\n        gr.basic_block.__init__(self,\n            name=\"\
      PDU to Ack/Nack\",\n            in_sig=[],\n            out_sig=[]\n       \
      \ )\n\n        # Input message port\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n\
      \        # Output message port\n        self.message_port_register_out(pmt.intern(\"\
      out\"))\n\n    def handle_msg(self, msg):\n        if not pmt.is_pair(msg):\n\
      \            print(\"[ERROR] Received non-PDU message. Ignored.\")\n       \
      \     return\n\n        meta = pmt.car(msg)  # metadata dictionary (can ignore)\n\
      \        data = pmt.cdr(msg)  # u8vector payload\n\n        # Convert u8vector\
      \ to Python string\n        try:\n            data_bytes = pmt.u8vector_elements(data)\n\
      \            msg_str = ''.join(chr(b) for b in data_bytes).lower()\n       \
      \ except:\n            print(\"[ERROR] Failed to convert PDU to string.\")\n\
      \            return\n\n        if msg_str not in (\"ack\", \"nack\"):\n    \
      \        print(f\"[WARNING] Unknown PDU content '{msg_str}'. Ignored.\")\n \
      \           return\n\n        self.message_port_pub(pmt.intern(\"out\"), pmt.intern(msg_str))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: '(''PDU to Ack/Nack'', ''PDUToAckNack'', [], [(''in'', ''message'',
      1)], [(''out'', ''message'', 1)], "\nConverts incoming PDUs into ''ack'' or
      ''nack'' symbols.\nInput PDU format: (metadata dict, u8vector of ASCII bytes)\n",
      [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 1712.0]
    rotation: 0
    state: enabled
