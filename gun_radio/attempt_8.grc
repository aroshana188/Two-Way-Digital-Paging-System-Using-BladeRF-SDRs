- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass AckNackGenerator(gr.basic_block):\n\
      \    \"\"\"\n    Simple ACK/NACK Generator.\n    - Receives messages on \"ok_in\"\
      \ or \"fail_in\".\n    - Outputs \"ack\" or \"nack\" symbols on \"out\".\n \
      \   Compatible with PDUFileSource's ctrl_in port.\n    \"\"\"\n\n    def __init__(self):\n\
      \        gr.basic_block.__init__(self, name=\"ACK/NACK Generator\", in_sig=[],\
      \ out_sig=[])\n\n        # Input ports\n        self.message_port_register_in(pmt.intern(\"\
      ok_in\"))\n        self.set_msg_handler(pmt.intern(\"ok_in\"), self.handle_ok)\n\
      \n        self.message_port_register_in(pmt.intern(\"fail_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      fail_in\"), self.handle_fail)\n\n        # Output port (to file source ctrl_in)\n\
      \        self.message_port_register_out(pmt.intern(\"out\"))\n\n    def handle_ok(self,\
      \ msg):\n        print(f\"[ACK/NACK] Sending ACK\")\n        self.message_port_pub(pmt.intern(\"\
      out\"), pmt.intern(\"ack\"))\n\n    def handle_fail(self, msg):\n        print(f\"\
      [ACK/NACK] Sending NACK\")\n        self.message_port_pub(pmt.intern(\"out\"\
      ), pmt.intern(\"nack\"))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('ACK/NACK Generator', 'AckNackGenerator', [], [('ok_in', 'message',
      1), ('fail_in', 'message', 1)], [('out', 'message', 1)], '\n    Simple ACK/NACK
      Generator.\n    - Receives messages on "ok_in" or "fail_in".\n    - Outputs
      "ack" or "nack" symbols on "out".\n    Compatible with PDUFileSource\'s ctrl_in
      port.\n    ', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 432.0]
    rotation: 180
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass TaggedStreamToFile(gr.basic_block):\n\
      \    \"\"\"\n    Writes incoming PDUs (Tagged Stream converted to PDU) into\
      \ a file,\n    including metadata. Appends all incoming PDUs sequentially.\n\
      \    \"\"\"\n\n    def __init__(self, filename=\"C:/Users/arosh/OneDrive/Desktop/output.txt\"\
      ):\n        gr.basic_block.__init__(\n            self,\n            name=\"\
      TaggedStreamToFile\",\n            in_sig=[],\n            out_sig=[]\n    \
      \    )\n        self.filename = filename\n\n        # Register message input\
      \ port\n        self.message_port_register_in(pmt.intern(\"in\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        # msg is\
      \ a PDU = (metadata dict, data vector)\n        meta = pmt.car(msg)        #\
      \ metadata dictionary\n        data = pmt.cdr(msg)        # u8vector payload\n\
      \n        # Convert data to Python bytes\n        data_bytes = bytes(pmt.u8vector_elements(data))\n\
      \n        # Convert metadata to string\n        try:\n            meta_str =\
      \ pmt.write_string(meta)\n        except:\n            meta_str = str(meta)\n\
      \n        # Append to file\n        with open(self.filename, \"ab\") as f:\n\
      \            f.write(b\"==== NEW PACKET ====\\n\")\n            f.write(f\"\
      Metadata: {meta_str}\\n\".encode())\n            f.write(b\"Payload: \" + data_bytes\
      \ + b\"\\n\\n\")\n"
    affinity: ''
    alias: ''
    comment: ''
    filename: r"C:\Users\PC\University\Semester_3\EN2130_Communication Design Project\Project\apple2.txt"
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('TaggedStreamToFile', 'TaggedStreamToFile', [('filename', "'C:/Users/arosh/OneDrive/Desktop/output.txt'")],
      [('in', 'message', 1)], [], '\n    Writes incoming PDUs (Tagged Stream converted
      to PDU) into a file,\n    including metadata. Appends all incoming PDUs sequentially.\n    ',
      ['filename'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 736.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "#!/usr/bin/env python3\n# PDUFileARQ.py\nfrom gnuradio import gr\n\
      import pmt\nimport os\n\nclass PDUFileARQ(gr.basic_block):\n    def __init__(self,\
      \ file_path=\"\", pdu_size=256):\n        gr.basic_block.__init__(\n       \
      \     self,\n            name=\"PDUFileARQ\",\n            in_sig=None,\n  \
      \          out_sig=None\n        )\n\n        self.file_path = file_path\n \
      \       self.pdu_size = int(pdu_size) if pdu_size else 256\n\n        # Load\
      \ file and chunk into list[list[int]]\n        self.pdus = []\n        if self.file_path\
      \ and os.path.isfile(self.file_path):\n            with open(self.file_path,\
      \ \"rb\") as f:\n                data = f.read()\n            self.pdus = [list(data[i:i+self.pdu_size])\n\
      \                         for i in range(0, len(data), self.pdu_size)]\n   \
      \     else:\n            if self.file_path:\n                print(f\"[ERROR]\
      \ File not found: {self.file_path}\")\n\n        self.current_index = 0\n  \
      \      self.message_port_register_out(pmt.intern(\"pdus_out\"))\n        self.message_port_register_in(pmt.intern(\"\
      control_in\"))\n        self.set_msg_handler(pmt.intern(\"control_in\"), self.handle_control_msg)\n\
      \n        print(f\"[INFO] PDUFileARQ initialized. {len(self.pdus)} PDUs loaded.\"\
      )\n\n    def start(self):\n        # Send the first PDU automatically when flowgraph\
      \ starts\n        if self.pdus:\n            self._publish_current_pdu()\n \
      \       return True\n\n    def _publish_current_pdu(self):\n        \"\"\"Send\
      \ current PDU as a proper (meta, data) pair.\"\"\"\n        if not (0 <= self.current_index\
      \ < len(self.pdus)):\n            return\n        pdu_list = self.pdus[self.current_index]\n\
      \        vec = pmt.init_u8vector(len(pdu_list), pdu_list)\n        msg = pmt.cons(pmt.PMT_NIL,\
      \ vec)\n        self.message_port_pub(pmt.intern(\"pdus_out\"), msg)\n     \
      \   print(f\"[DEBUG] Sent PDU index={self.current_index}, size={len(pdu_list)}\"\
      )\n\n    def handle_control_msg(self, msg_pmt):\n        \"\"\"Handle ack/nack\
      \ control messages (PMT symbol or (meta, symbol) pair).\"\"\"\n        command\
      \ = None\n\n        # Case 1: message is a symbol\n        if pmt.is_symbol(msg_pmt):\n\
      \            command = pmt.symbol_to_string(msg_pmt)\n\n        # Case 2: message\
      \ is a pair (meta, symbol)\n        elif pmt.is_pair(msg_pmt):\n           \
      \ payload = pmt.cdr(msg_pmt)\n            if pmt.is_symbol(payload):\n     \
      \           command = pmt.symbol_to_string(payload)\n\n        if command is\
      \ None:\n            print(\"[WARNING] Unknown control message format. Ignored.\"\
      )\n            return\n\n        command = command.lower().strip()\n       \
      \ if command == \"ack\":\n            if self.current_index < len(self.pdus)\
      \ - 1:\n                self.current_index += 1\n                self._publish_current_pdu()\n\
      \            else:\n                print(\"[INFO] All PDUs acknowledged.\"\
      )\n        elif command == \"nack\":\n            print(\"[DEBUG] NACK received\
      \ \u2013 resending current PDU\")\n            self._publish_current_pdu()\n\
      \        else:\n            print(f\"[WARNING] Unknown control command '{command}'\"\
      )\n"
    affinity: ''
    alias: ''
    comment: ''
    file_path: r"C:\Users\PC\University\Semester_3\EN2130_Communication Design Project\Project\apple.txt"
    maxoutbuf: '0'
    minoutbuf: '0'
    pdu_size: '256'
  states:
    _io_cache: ('PDUFileARQ', 'PDUFileARQ', [('file_path', "''"), ('pdu_size', '256')],
      [('control_in', 'message', 1)], [('pdus_out', 'message', 1)], '', ['file_path',
      'pdu_size'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 164.0]
    rotation: 0
    state: enabled
