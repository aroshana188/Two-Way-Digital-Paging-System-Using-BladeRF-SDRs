- name: epy_block_4
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Sequence Number Checker & ARQ Logic\
      \ (Debug Mode)\n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\nimport\
      \ pmt\n\nclass seq_num_checker(gr.basic_block):\n    def __init__(self):\n \
      \       gr.basic_block.__init__(self,\n            name=\"Sequence Num Checker\"\
      ,\n            in_sig=None,\n            out_sig=None)\n\n        # Register\
      \ Ports\n        self.message_port_register_in(pmt.intern(\"pdu_in\"))\n   \
      \     self.message_port_register_out(pmt.intern(\"pdu_out\"))      # For valid\
      \ data\n        self.message_port_register_out(pmt.intern(\"request_out\"))\
      \  # For ACKs\n\n        # Bind Handler\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in\"), self.handle_msg)\n\n        # Internal State\n        self.rn = 0\
      \  # Request Number (The Sequence Number we are waiting for)\n        print(\"\
      [RX Checker] Block Initialized. Waiting for Packet 0.\")\n\n    def handle_msg(self,\
      \ msg):\n        # 1. Validate PDU\n        if not pmt.is_pdu(msg):\n      \
      \      return\n\n        # 2. Extract Data\n        data_pdu = pmt.cdr(msg)\n\
      \        data_bytes = pmt.u8vector_elements(data_pdu)\n        \n        if\
      \ len(data_bytes) < 1:\n            print(\"[RX Checker] Warning: Received empty\
      \ packet.\")\n            return \n\n        # 3. Get Sequence Number (First\
      \ byte)\n        sn_received = data_bytes[0]\n\n        # Debug Print: What\
      \ came in?\n        print(f\"[RX Checker] INCOMING: SN={sn_received} | EXPECTING:\
      \ RN={self.rn}\")\n\n        # 4. Compare SN with RN\n        if sn_received\
      \ == self.rn:\n            # --- VALID PACKET CASE ---\n            print(f\"\
      \    -> MATCH! Accepting Packet {sn_received}.\")\n            \n          \
      \  # A. Prepare Payload (Strip SN)\n            payload = data_bytes[1:]\n \
      \           \n            # B. Publish Payload\n            if len(payload)\
      \ > 0:\n                meta = pmt.car(msg)\n                out_vector = pmt.init_u8vector(len(payload),\
      \ payload)\n                out_msg = pmt.cons(meta, out_vector)\n         \
      \       self.message_port_pub(pmt.intern(\"pdu_out\"), out_msg)\n          \
      \  \n            # C. Increment Request Number\n            old_rn = self.rn\n\
      \            self.rn = (self.rn + 1) % 256\n            \n            # D. Send\
      \ NEW Request Number\n            print(f\"    -> UPDATING RN: {old_rn} -> {self.rn}.\
      \ Sending ACK/Req {self.rn}\")\n            self.send_request(self.rn)\n   \
      \         \n        else:\n            # --- DUPLICATE OR WRONG PACKET CASE\
      \ ---\n            # This is expected behavior for the 9 duplicate copies\n\
      \            print(f\"    -> IGNORED: SN {sn_received} != RN {self.rn}. (Likely\
      \ duplicate). Re-sending Req {self.rn}\")\n            \n            # A. Re-send\
      \ the CURRENT Request Number\n            self.send_request(self.rn)\n\n   \
      \ def send_request(self, num):\n        msg = pmt.from_long(num)\n        self.message_port_pub(pmt.intern(\"\
      request_out\"), msg)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
