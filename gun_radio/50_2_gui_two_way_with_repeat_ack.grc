- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: ACK Debug Logger\nFunction: Prints\
      \ received ACK details to the console.\nInput: Expects PDU with payload [MsgID,\
      \ RN] from Address Filter (ack_out).\n\"\"\"\nimport numpy as np\nfrom gnuradio\
      \ import gr\nimport pmt\nimport datetime\n\nclass ack_logger(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(self,\n          \
      \  name=\"ACK Debug Logger\",\n            in_sig=None,\n            out_sig=None)\n\
      \n        self.message_port_register_in(pmt.intern(\"in\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.handle_msg)\n\n    def get_timestamp(self):\n        return datetime.datetime.now().strftime(\"\
      %H:%M:%S\")\n\n    def handle_msg(self, msg):\n        try:\n            payload\
      \ = pmt.cdr(msg)\n            \n            # The 'ack_out' port from Address\
      \ Filter sends a PDU of 2 bytes: [MsgID, RN]\n            if pmt.is_u8vector(payload):\n\
      \                data = list(pmt.u8vector_elements(payload))\n             \
      \   \n                if len(data) >= 2:\n                    msg_id = data[0]\n\
      \                    rn_num = data[1]\n                    timestamp = self.get_timestamp()\n\
      \                    \n                    print(f\"[{timestamp}] [ACK RECV]\
      \ Received ACK for MsgID: {msg_id}, Requesting Next Seq: {rn_num}\")\n     \
      \           else:\n                    print(f\"[ACK Logger] Warning: Received\
      \ short ACK payload (<2 bytes)\")\n            \n        except Exception as\
      \ e:\n            print(f\"[ACK Logger] Error: {e}\")"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
