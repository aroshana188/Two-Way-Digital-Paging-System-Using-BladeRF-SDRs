- name: epy_block_12
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ time\nimport threading\n\nclass pdu_file_source(gr.basic_block):\n    def\
      \ __init__(self, file_path='/home/user/test.txt', pdu_size=50, interval=1.0,\
      \ flush_count=10, preamble_count=20, log_file=''):\n        gr.basic_block.__init__(self,\n\
      \            name=\"File Source\",\n            in_sig=None,\n            out_sig=None)\n\
      \n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n      \
      \  self.file_path = file_path\n        self.pdu_size = pdu_size\n        self.interval\
      \ = interval\n        self.flush_count = flush_count\n        self.preamble_count\
      \ = preamble_count\n        self.log_file_path = log_file\n        \n      \
      \  self.seq_num = 0\n        self.stop_thread = False\n        self.thread =\
      \ threading.Thread(target=self.run)\n        self.thread.daemon = True\n\n \
      \       # Init Log\n        if self.log_file_path != '':\n            try:\n\
      \                with open(self.log_file_path, 'w') as f:\n                \
      \    f.write(\"--- TX SOURCE LOG START ---\\n\")\n            except: pass\n\
      \n    def log(self, msg):\n        print(msg)\n        if self.log_file_path\
      \ != '':\n            try:\n                with open(self.log_file_path, 'a')\
      \ as f:\n                    t = time.strftime(\"%H:%M:%S\", time.localtime())\n\
      \                    f.write(f\"[{t}] {msg}\\n\")\n            except: pass\n\
      \n    def start(self):\n        self.stop_thread = False\n        self.thread.start()\n\
      \        return True\n\n    def stop(self):\n        self.stop_thread = True\n\
      \        self.thread.join()\n        return True\n\n    def send_dummy_packet(self,\
      \ capacity):\n        dummy_payload = [self.seq_num] + ([0] * capacity)\n  \
      \      data_pmt = pmt.init_u8vector(len(dummy_payload), dummy_payload)\n   \
      \     pdu_msg = pmt.cons(pmt.PMT_NIL, data_pmt)\n        self.message_port_pub(pmt.intern(\"\
      pdu_out\"), pdu_msg)\n        self.seq_num = (self.seq_num + 1) % 256\n    \
      \    time.sleep(self.interval)\n\n    def run(self):\n        time.sleep(2.0)\
      \ \n        data_capacity = self.pdu_size - 1\n\n        self.log(f\"[File Source]\t\
      \       Sending {self.preamble_count} Preamble packets...\")\n        self.seq_num\
      \ = (256 - self.preamble_count) % 256\n        \n        for _ in range(self.preamble_count):\n\
      \            if self.stop_thread: break\n            self.send_dummy_packet(data_capacity)\n\
      \n        # --- PART 1: SEND FILE ---\n        try:\n            with open(self.file_path,\
      \ 'rb') as f:\n                file_data = f.read()\n        except Exception\
      \ as e:\n            self.log(f\"[File Source Error] {e}\")\n            return\n\
      \n        total_len = len(file_data)\n        cursor = 0\n        self.log(f\"\
      [File Source]\t       Starting File Transmission (Packet #{self.seq_num})...\"\
      )\n\n        while not self.stop_thread and cursor < total_len:\n          \
      \  end_pointer = min(cursor + data_capacity, total_len)\n            data_chunk\
      \ = file_data[cursor : end_pointer]\n            actual_len = len(data_chunk)\n\
      \            padding_list = [0] * (data_capacity - actual_len)\n\n         \
      \   payload_bytes = [self.seq_num] + list(data_chunk) + padding_list\n     \
      \       data_pmt = pmt.init_u8vector(len(payload_bytes), payload_bytes)\n  \
      \          self.message_port_pub(pmt.intern(\"pdu_out\"), pmt.cons(pmt.PMT_NIL,\
      \ data_pmt))\n            \n            cursor += actual_len\n            self.seq_num\
      \ = (self.seq_num + 1) % 256\n            time.sleep(self.interval)\n\n    \
      \    self.log(f\"[File Source]\t       File Done. Sending Flush...\")\n    \
      \    for _ in range(self.flush_count):\n            if self.stop_thread: break\n\
      \            self.send_dummy_packet(data_capacity)\n\n        self.log(\"[File\
      \ Source]               Idle mode.\")\n        while not self.stop_thread:\n\
      \            time.sleep(1.0)"
    affinity: ''
    alias: ''
    comment: ''
    file_path: '"C:/Users/PC/Desktop/Input.txt"'
    flush_count: '1'
    interval: '0.1'
    log_file: '"C:/Users/PC/Desktop/Transmitter log.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
    pdu_size: '64'
    preamble_count: '0'
  states:
    _io_cache: ('File Source', 'pdu_file_source', [('file_path', "'/home/user/test.txt'"),
      ('pdu_size', '50'), ('interval', '1.0'), ('flush_count', '10'), ('preamble_count',
      '20'), ('log_file', "''")], [], [('pdu_out', 'message', 1)], '', ['file_path',
      'flush_count', 'interval', 'pdu_size', 'preamble_count'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [672, 64.0]
    rotation: 0
    state: enabled
- name: epy_block_13
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ os\n\nclass pdu_file_sink(gr.basic_block):\n    def __init__(self, file_path='/home/user/output.txt',\
      \ append_to_file=False):\n        gr.basic_block.__init__(self,\n          \
      \  name=\"PDU to Text File Sink\",\n            in_sig=None,\n            out_sig=None)\n\
      \n        # INPUT: Validated Frames from Sequence Checker\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \n        self.file_path = file_path\n        \n        # Logic to handle file\
      \ modes\n        # If append is False, we delete the old file when the flowgraph\
      \ starts\n        if not append_to_file:\n            if os.path.exists(self.file_path):\n\
      \                try:\n                    os.remove(self.file_path)\n     \
      \               print(f\"[File Sink] Deleted old file: {self.file_path}\")\n\
      \                except Exception as e:\n                    print(f\"[File\
      \ Sink Error] Could not clean file: {e}\")\n\n    def handle_msg(self, msg):\n\
      \        try:\n            # 1. Extract Data\n            payload_pmt = pmt.cdr(msg)\n\
      \            data_list = pmt.u8vector_elements(payload_pmt)\n            \n\
      \            # Safety Check: Must have at least 3 bytes header + 1 byte data\n\
      \            if len(data_list) < 4:\n                return\n\n            #\
      \ 2. Strip Header (SRC, DST, SN)\n            # The actual text starts at index\
      \ 3\n            raw_payload = bytes(data_list[3:])\n            \n        \
      \    # 3. Remove Zero Padding\n            # This removes any 0x00 bytes from\
      \ the RIGHT side of the packet\n            clean_payload = raw_payload.rstrip(b'\\\
      x00')\n            \n            # 4. Decode to Text\n            # We use 'replace'\
      \ to prevent crashing if a bit error slipped through\n            text_data\
      \ = clean_payload.decode('utf-8', errors='replace')\n            \n        \
      \    # 5. Write to File\n            # We open in 'a' (append) mode so we add\
      \ to the end of the file\n            with open(self.file_path, 'a', encoding='utf-8')\
      \ as f:\n                f.write(text_data)\n                # Note: We do NOT\
      \ add a newline here, because the original file \n                # might have\
      \ been split in the middle of a sentence.\n                \n            # Optional:\
      \ Print progress\n            # print(f\"[File Sink] Wrote {len(text_data)}\
      \ characters.\")\n\n        except Exception as e:\n            print(f\"[File\
      \ Sink Error] {e}\")"
    affinity: ''
    alias: ''
    append_to_file: 'False'
    comment: ''
    file_path: '"C:/Users/PC/Desktop/Output.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('PDU to Text File Sink', 'pdu_file_sink', [('file_path', "'/home/user/output.txt'"),
      ('append_to_file', 'False')], [('pdu_in', 'message', 1)], [], '', ['file_path'])
    bus_sink: false
    bus_source: false
    bus_structure: null
