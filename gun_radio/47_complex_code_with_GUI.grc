- name: epy_block_3
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Smart Packetizer (Robust)\nHandles\
      \ both Text Symbols and Byte Vectors.\nStructure: [Src IP(4)][Dst IP(4)][SN(1)]\
      \ | [Message][Padding]\n\"\"\"\nimport numpy as np\nfrom gnuradio import gr\n\
      import pmt\nimport struct\n\ndef ip_str_to_list(ip_string):\n    try:\n    \
      \    return [int(x) for x in ip_string.strip().split('.')]\n    except:\n  \
      \      return [0, 0, 0, 0]\n\nclass Packetizer(gr.basic_block):\n    def __init__(self,\
      \ src_ip=\"192.168.1.10\", packet_len=73):\n        gr.basic_block.__init__(self,\n\
      \            name=\"Smart Packetizer (Robust)\",\n            in_sig=None,\n\
      \            out_sig=None)\n        \n        self.src_ip_bytes = ip_str_to_list(src_ip)\n\
      \        self.seq_num = 0\n        \n        # --- Validate Packet Length ---\n\
      \        # Header is 9 bytes (4 Src + 4 Dst + 1 SN)\n        header_len = 9\n\
      \        target_payload = packet_len - header_len\n        \n        # Ensure\
      \ payload is multiple of 16 for AES\n        if target_payload % 16 != 0:\n\
      \            valid_payload = (target_payload // 16) * 16\n            self.final_packet_len\
      \ = valid_payload + header_len\n            print(f\"[Packetizer] Auto-adjusted\
      \ Packet Length to: {self.final_packet_len}\")\n        else:\n            self.final_packet_len\
      \ = packet_len\n\n        self.message_port_register_in(pmt.intern(\"in\"))\n\
      \        self.message_port_register_out(pmt.intern(\"out\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        try:\n  \
      \          payload_pmt = pmt.cdr(msg) \n            \n            # --- ROBUST\
      \ TYPE CHECKING ---\n            if pmt.is_u8vector(payload_pmt):\n        \
      \        # Handle Raw Bytes\n                u8_list = pmt.u8vector_elements(payload_pmt)\n\
      \                full_text = \"\".join([chr(x) for x in u8_list])\n        \
      \        \n            elif pmt.is_symbol(payload_pmt):\n                # Handle\
      \ Text Symbol (This is what you are receiving)\n                full_text =\
      \ pmt.symbol_to_string(payload_pmt)\n                \n            elif pmt.is_pair(payload_pmt):\n\
      \                 # Sometimes ZMQ wraps it in another pair\n               \
      \  full_text = str(payload_pmt)\n            else:\n                print(f\"\
      [Packetizer] Unknown Input Type: {payload_pmt}\")\n                return\n\n\
      \            # --- PARSING ---\n            # Expects: \"[INFO] IP:192.168.1.20\
      \ MSG:hello\"\n            if \"MSG:\" not in full_text or \"IP:\" not in full_text:\n\
      \                print(f\"[Packetizer] Invalid Format: {full_text}\")\n    \
      \            return\n\n            part1 = full_text.split(\"MSG:\")\n     \
      \       message_text = part1[1]\n            \n            part2 = part1[0].split(\"\
      IP:\")\n            dest_ip_str = part2[1].strip()\n            dest_ip_bytes\
      \ = ip_str_to_list(dest_ip_str)\n\n        except Exception as e:\n        \
      \    print(f\"[Packetizer] Parsing Error: {e}\")\n            return\n\n   \
      \     # 1. Build Header (9 Bytes - CLEAR TEXT)\n        # [Src IP (4)] + [Dst\
      \ IP (4)] + [Seq Num (1)]\n        seq_byte = list(struct.pack(\"B\", self.seq_num))\n\
      \        self.seq_num = (self.seq_num + 1) % 256\n        \n        header =\
      \ self.src_ip_bytes + dest_ip_bytes + seq_byte\n        \n        # 2. Build\
      \ Payload (Message)\n        msg_bytes = [ord(c) for c in message_text]\n\n\
      \        # 3. Calculate Padding (For AES)\n        total_payload_space = self.final_packet_len\
      \ - 9\n        \n        if len(msg_bytes) > total_payload_space:\n        \
      \    msg_bytes = msg_bytes[:total_payload_space]\n            \n        pad_len\
      \ = total_payload_space - len(msg_bytes)\n        padding = [0] * pad_len\n\
      \        \n        payload_block = msg_bytes + padding\n\n        # 4. Combine\n\
      \        final_packet = header + payload_block\n        \n        # 5. Send\n\
      \        out_payload = pmt.init_u8vector(len(final_packet), final_packet)\n\
      \        out_msg = pmt.cons(pmt.PMT_NIL, out_payload)\n        self.message_port_pub(pmt.intern(\"\
      out\"), out_msg)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: '32'
    src_ip: '"192.168.1.10"'
  states:
    _io_cache: ('Smart Packetizer (Robust)', 'Packetizer', [('src_ip', "'192.168.1.10'"),
      ('packet_len', '73')], [('in', 'message', 1)], [('out', 'message', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [936, 300.0]
    rotation: 0
    state: disabled
- name: epy_block_3_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: PDU Splitter\n\"\"\"\n\nimport numpy\
      \ as np\nfrom gnuradio import gr\nimport pmt\n\nclass pdu_splitter(gr.basic_block):\n\
      \    def __init__(self, num_duplicates=10):\n        # Default num_duplicates\
      \ set to 10 to match your transmitter image\n        gr.basic_block.__init__(self,\n\
      \            name=\"PDU Splitter\",\n            in_sig=None,\n            out_sig=None)\n\
      \        \n        self.n = num_duplicates\n\n        # Register Ports\n   \
      \     self.message_port_register_in(pmt.intern(\"pdu_in\"))\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n        \n        # Bind Handler\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        # Ensure\
      \ we are handling a PDU\n        if pmt.is_pdu(msg):\n            meta = pmt.car(msg)\n\
      \            vector_data = pmt.cdr(msg)\n            \n            # Convert\
      \ PMT vector to Python list/tuple of bytes\n            data = pmt.u8vector_elements(vector_data)\n\
      \            total_len = len(data)\n            \n            # Validation:\
      \ The total length must be divisible by N\n            if total_len == 0 or\
      \ (total_len % self.n != 0):\n                # If the packet size is wrong\
      \ (likely due to noise shifting the header),\n                # we cannot safely\
      \ split it. Drop it.\n                return\n\n            # Calculate the\
      \ size of one sub-packet (Payload + CRC)\n            chunk_len = total_len\
      \ // self.n\n            \n            # Loop N times to slice and send each\
      \ copy\n            for i in range(self.n):\n                start = i * chunk_len\n\
      \                end = start + chunk_len\n                \n               \
      \ # Extract the slice\n                sub_packet = data[start:end]\n      \
      \          \n                # Create new PMT vector\n                out_vector\
      \ = pmt.init_u8vector(len(sub_packet), sub_packet)\n                \n     \
      \           # Create new PDU (preserving original metadata)\n              \
      \  out_msg = pmt.cons(meta, out_vector)\n                \n                #\
      \ Send to output\n                self.message_port_pub(pmt.intern(\"pdu_out\"\
      ), out_msg)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_duplicates: '8'
  states:
    _io_cache: ('PDU Splitter', 'pdu_splitter', [('num_duplicates', '10')], [('pdu_in',
      'message', 1)], [('pdu_out', 'message', 1)], '', [])
