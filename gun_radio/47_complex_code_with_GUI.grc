- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: File Source PDU (Corrected for 1-Byte\
      \ SN)\n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ threading\nimport time\nimport struct\nimport os\n\nclass file_source_pdu(gr.basic_block):\n\
      \    def __init__(self, filename='message.txt', pdu_size=64, delay=0.05):\n\
      \        \"\"\"\n        Args:\n            filename: Path to the text file.\n\
      \            pdu_size: Total size of the output PDU in bytes.\n            delay:\
      \ Time delay between sending PDUs.\n        \"\"\"\n        gr.basic_block.__init__(self,\n\
      \            name=\"File Source PDU\",\n            in_sig=None,\n         \
      \   out_sig=None)\n\n        self.message_port_register_out(pmt.intern('pdu_out'))\n\
      \n        self.filename = filename\n        self.pdu_size = pdu_size\n     \
      \   self.delay = delay\n        \n        # FIXED: Hardcoded to 1 byte because\
      \ your Receiver expects data_bytes[0] to be the SN\n        self.seq_len = 1\
      \ \n        self.payload_size = self.pdu_size - self.seq_len\n\n        self.stop_thread\
      \ = False\n        self.thread = threading.Thread(target=self.run)\n       \
      \ self.thread.daemon = True\n\n    def start(self):\n        self.stop_thread\
      \ = False\n        self.thread.start()\n        return True\n\n    def stop(self):\n\
      \        self.stop_thread = True\n        if self.thread.is_alive():\n     \
      \       self.thread.join()\n        return True\n\n    def run(self):\n    \
      \    time.sleep(1)\n        \n        if not os.path.exists(self.filename):\n\
      \            print(f\"[Error] File not found: {self.filename}\")\n         \
      \   return\n\n        with open(self.filename, 'rb') as f:\n            file_content\
      \ = f.read()\n\n        data = bytearray(file_content)\n        total_len =\
      \ len(data)\n        num_packets = (total_len + self.payload_size - 1) // self.payload_size\n\
      \        \n        print(f\"[File Source] Sending {total_len} bytes in {num_packets}\
      \ packets.\")\n\n        seq_num = 0\n        \n        for i in range(0, total_len,\
      \ self.payload_size):\n            if self.stop_thread:\n                break\n\
      \n            # 1. Slice the data\n            chunk = data[i : i + self.payload_size]\n\
      \            \n            # 2. Add Sequence Number (Header)\n            #\
      \ FIXED: 'B' packs it as a single unsigned byte (0-255)\n            # We use\
      \ % 256 to ensure it wraps around and doesn't crash if file is large\n     \
      \       header = struct.pack('B', seq_num % 256) \n            \n          \
      \  # 3. Add Padding (if needed)\n            current_len = len(chunk) + len(header)\n\
      \            padding_len = self.pdu_size - current_len\n            \n     \
      \       if padding_len > 0:\n                padding = b'\\x00' * padding_len\n\
      \                chunk = chunk + padding\n            \n            # Combine\n\
      \            full_packet = header + chunk\n            \n            # 4. Create\
      \ PDU\n            meta = pmt.make_dict()\n            meta = pmt.dict_add(meta,\
      \ pmt.intern(\"seq_num\"), pmt.from_long(seq_num))\n            \n         \
      \   # Convert to PMT vector\n            pdu_vector = pmt.init_u8vector(len(full_packet),\
      \ list(full_packet))\n            pdu = pmt.cons(meta, pdu_vector)\n       \
      \     \n            # 5. Send\n            self.message_port_pub(pmt.intern('pdu_out'),\
      \ pdu)\n            \n            print(f\"[Sent] Seq: {seq_num % 256}, Size:\
      \ {len(full_packet)}\")\n            \n            seq_num += 1\n          \
      \  time.sleep(self.delay)"
    affinity: ''
    alias: ''
    comment: ''
    delay: '0.1'
    filename: '"C:/Users/arosh/OneDrive/Desktop/TX_1.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
    pdu_size: '64'
  states:
    _io_cache: '(''File Source PDU'', ''file_source_pdu'', [(''filename'', "''message.txt''"),
      (''pdu_size'', ''64''), (''delay'', ''0.05'')], [], [(''pdu_out'', ''message'',
      1)], ''\n        Args:\n            filename: Path to the text file.\n            pdu_size:
      Total size of the output PDU in bytes.\n            delay: Time delay between
      sending PDUs.\n        '', [''delay'', ''filename'', ''pdu_size''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [752, 180.0]
    rotation: 0
    state: disabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: PDU Storage & ARQ Controller (With\
      \ Debug Prints)\n\"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\nimport\
      \ pmt\nimport threading\nimport time\n\nclass pdu_arq_controller(gr.basic_block):\n\
      \    def __init__(self, timeout_s=1.0, max_retries=5):\n        gr.basic_block.__init__(self,\n\
      \            name=\"PDU Storage ARQ\",\n            in_sig=None,\n         \
      \   out_sig=None)\n\n        # 1. Register Message Ports\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.message_port_register_in(pmt.intern(\"request_in\"\
      ))\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n    \
      \    # 2. Bind Message Handlers\n        self.set_msg_handler(pmt.intern(\"\
      pdu_in\"), self.handle_pdu)\n        self.set_msg_handler(pmt.intern(\"request_in\"\
      ), self.handle_request)\n\n        # 3. State Variables\n        self.buffer\
      \ = []          \n        self.curr_idx = 0         \n        self.retries =\
      \ 0          \n        self.max_retries = max_retries\n        self.timeout_s\
      \ = timeout_s \n        \n        # Timer and Thread Safety\n        self.timer\
      \ = None\n        self.lock = threading.Lock() \n\n        print(f\"[ARQ] Block\
      \ Initialized. Timeout: {self.timeout_s}s, Max Retries: {self.max_retries}\"\
      )\n\n    def __del__(self):\n        self.stop_timer()\n\n    def stop_timer(self):\n\
      \        if self.timer:\n            self.timer.cancel()\n            self.timer\
      \ = None\n\n    def start_timer(self):\n        self.stop_timer() \n       \
      \ # Create a new timer thread\n        self.timer = threading.Timer(self.timeout_s,\
      \ self.handle_timeout)\n        self.timer.start()\n        # Debug Print\n\
      \        # print(f\"[ARQ] Timer started for {self.timeout_s}s\") \n\n    def\
      \ send_packet(self, index):\n        # Note: This function is usually called\
      \ from inside a locked context\n        if index < len(self.buffer):\n     \
      \       pdu = self.buffer[index]\n            \n            # Send PDU\n   \
      \         self.message_port_pub(pmt.intern(\"pdu_out\"), pdu)\n            \n\
      \            print(f\"[ARQ] SENT Packet {index} (Retry {self.retries}/{self.max_retries})\"\
      )\n            \n            # Restart Timer\n            self.start_timer()\n\
      \        else:\n            print(f\"[ARQ] Waiting... (Index {index} not in\
      \ buffer of size {len(self.buffer)})\")\n\n    def handle_timeout(self):\n \
      \       \"\"\" Triggered when timer expires \"\"\"\n        with self.lock:\n\
      \            print(f\"[ARQ] TIMEOUT reached for Packet {self.curr_idx}\")\n\n\
      \            if self.curr_idx >= len(self.buffer):\n                print(\"\
      [ARQ] Buffer exhausted, nothing to send.\")\n                return\n\n    \
      \        if self.retries < self.max_retries:\n                # Case A: Retry\
      \ limit not reached -> Resend Same Packet\n                self.retries += 1\n\
      \                print(f\"[ARQ] Retry limit not reached. Resending Packet {self.curr_idx}...\"\
      )\n                self.send_packet(self.curr_idx)\n            else:\n    \
      \            # Case B: Max retries reached -> Give Up & Move Next\n        \
      \        print(f\"[ARQ] MAX RETRIES ({self.max_retries}) reached for Packet\
      \ {self.curr_idx}. SKIPPING.\")\n                \n                self.curr_idx\
      \ += 1\n                self.retries = 0 \n                \n              \
      \  if self.curr_idx < len(self.buffer):\n                    print(f\"[ARQ]\
      \ Advancing to Packet {self.curr_idx}\")\n                    self.send_packet(self.curr_idx)\n\
      \                else:\n                    print(\"[ARQ] No more packets to\
      \ send.\")\n\n    def handle_request(self, msg):\n        \"\"\" Triggered when\
      \ receiver asks for a packet \"\"\"\n        with self.lock:\n            try:\n\
      \                # Robust input parsing\n                if pmt.is_pdu(msg):\n\
      \                    data = pmt.to_python(pmt.cdr(msg))\n                  \
      \  req_num = int(data[0]) \n                elif pmt.is_integer(msg):\n    \
      \                req_num = pmt.to_long(msg)\n                elif pmt.is_pair(msg):\
      \ \n                    # Sometimes integers come as a pair (val . val)\n  \
      \                  req_num = pmt.to_long(pmt.car(msg))\n                else:\n\
      \                    print(f\"[ARQ] Error: Unknown request message format: {msg}\"\
      )\n                    return\n            except Exception as e:\n        \
      \        print(f\"[ARQ] Error parsing request: {e}\")\n                return\n\
      \n            print(f\"[ARQ] REQUEST RECEIVED for Packet {req_num}\")\n\n  \
      \          # Logic: Receiver wants 'req_num'\n            # We reset retries\
      \ because the link is alive (we got a request)\n            self.curr_idx =\
      \ req_num\n            self.retries = 0\n            \n            # Send immediately\
      \ and restart timer\n            self.send_packet(self.curr_idx)\n\n    def\
      \ handle_pdu(self, msg):\n        \"\"\" Triggered when File Source provides\
      \ data \"\"\"\n        with self.lock:\n            self.buffer.append(msg)\n\
      \            print(f\"[ARQ] STORED new PDU. Buffer size: {len(self.buffer)}\"\
      )\n            \n            # If this is the FIRST packet arriving, kickstart\
      \ the process\n            if len(self.buffer) == 1:\n                print(\"\
      [ARQ] Starting transmission with Packet 0\")\n                self.curr_idx\
      \ = 0\n                self.retries = 0\n                self.send_packet(0)"
    affinity: ''
    alias: ''
    comment: ''
    max_retries: '10'
    maxoutbuf: '0'
    minoutbuf: '0'
    timeout_s: '1'
  states:
    _io_cache: ('PDU Storage ARQ', 'pdu_arq_controller', [('timeout_s', '1.0'), ('max_retries',
      '5')], [('request_in', 'message', 1), ('pdu_in', 'message', 1)], [('pdu_out',
      'message', 1)], '', ['max_retries', 'timeout_s'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1464, 172.0]
    rotation: 0
    state: disabled
- name: epy_block_10
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: PDU Prepend Dummy\n\"\"\"\n\nimport\
      \ numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass pdu_prepend_dummy(gr.basic_block):\n\
      \    def __init__(self, dummy_bytes=20):\n        \"\"\"\n        Args:\n  \
      \          dummy_bytes: Number of '0x55' bytes to add to the front.\n      \
      \  \"\"\"\n        gr.basic_block.__init__(self,\n            name=\"PDU Prepend\
      \ Dummy\",\n            in_sig=None,\n            out_sig=None)\n\n        self.d_len\
      \ = dummy_bytes\n\n        # Register Ports\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\
      \        \n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \n    def handle_msg(self, msg):\n        # 1. Validate Input\n        if not\
      \ pmt.is_pdu(msg):\n            return\n\n        # 2. Extract Data\n      \
      \  meta = pmt.car(msg)\n        data_pdu = pmt.cdr(msg)\n        original_data\
      \ = list(pmt.u8vector_elements(data_pdu))\n        \n        # 3. Create Dummy\
      \ Data\n        # We use 0x55 (Binary: 01010101) because it creates excellent\
      \ \n        # bit transitions for synchronization.\n        dummy_pattern =\
      \ [0x55] * self.d_len\n        \n        # 4. Prepend (Dummy + Original)\n \
      \       new_data = dummy_pattern + original_data\n        \n        # 5. Pack\
      \ and Publish\n        out_vector = pmt.init_u8vector(len(new_data), new_data)\n\
      \        out_msg = pmt.cons(meta, out_vector)\n        \n        self.message_port_pub(pmt.intern(\"\
      pdu_out\"), out_msg)"
    affinity: ''
    alias: ''
    comment: ''
    dummy_bytes: extra_bytes
