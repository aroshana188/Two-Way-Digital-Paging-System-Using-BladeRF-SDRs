- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"Example ACK generator\"\"\"\n    def __init__(self):\n        gr.basic_block.__init__(\n\
      \            self,\n            name=\"ACK Generator\",\n            in_sig=[],\n\
      \            out_sig=[]\n        )\n        # Define message port for PDU output\n\
      \        self.message_port_register_out(pmt.intern(\"out\"))\n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n\
      \    def handle_msg(self, msg):\n        # msg is a PDU received from upstream\n\
      \        # You can check packet integrity here\n        if self.check_crc(msg):\n\
      \            # Construct ACK PDU\n            ack = pmt.cons(pmt.make_dict(),\
      \ pmt.init_u8vector(3, bytearray(b\"ACK\")))\n            self.message_port_pub(pmt.intern(\"\
      out\"), ack)\n\n    def check_crc(self, msg):\n        # Add your CRC check\
      \ logic\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('ACK Generator', 'blk', [], [('in', 'message', 1)], [('out', 'message',
      1)], 'Example ACK generator', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1392, 968.0]
    rotation: 180
    state: disabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import pmt\nseq = 0\n\ndef handle_pdu(msg):\n    global seq\n \
      \   meta = pmt.car(msg)\n    vec  = bytearray(pmt.u8vector_elements(pmt.cdr(msg)))\n\
      \    vec.insert(0, seq & 0xFF)         # put seq at start (1 byte)\n    seq\
      \ = (seq + 1) % 256\n    out = pmt.cons(meta, pmt.init_u8vector(len(vec), vec))\n\
      \    message_port_pub(pmt.intern(\"out\"), out)\n"
    affinity: ''
    alias: ''
    comment: ''
    example_param: '1.0'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Embedded Python Block', 'blk', [('example_param', '1.0')], [('0',
      'complex', 1)], [('0', 'complex', 1)], 'Embedded Python Block example - a simple
      multiply const', ['example_param'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 400.0]
    rotation: 0
    state: disabled
