    _io_cache: '(''PDU Queue & Storage'', ''PDUQueueStorage'', [(''timeout'', ''1.0''),
      (''max_retries'', ''5'')], [(''rn_in'', ''message'', 1), (''pdu_in'', ''message'',
      1)], [(''pdu_out'', ''message'', 1)], ''\n        timeout: Delay between retransmissions
      in a burst.\n        max_retries: Number of times to send in one burst (e.g.,
      5 -> A,A,A,A,A).\n        '', [''max_retries'', ''timeout''])'
