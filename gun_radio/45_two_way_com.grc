- name: epy_block_6
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: PDU Add Addressing (IP Support)\n\
      \"\"\"\n\nimport numpy as np\nfrom gnuradio import gr\nimport pmt\nimport struct\n\
      import socket\n\nclass pdu_add_addressing(gr.basic_block):\n    def __init__(self,\
      \ src_ip=\"192.168.1.10\", dest_ip=\"192.168.1.20\"):\n        \"\"\"\n    \
      \    Args:\n            src_ip: Source IP Address (String, e.g., \"192.168.1.10\"\
      )\n            dest_ip: Destination IP Address (String)\n        \"\"\"\n  \
      \      gr.basic_block.__init__(self,\n            name=\"PDU Add Addressing\"\
      ,\n            in_sig=None,\n            out_sig=None)\n\n        # Convert\
      \ IP Strings to 4-byte binary format\n        # inet_aton converts \"192.168.1.1\"\
      \ -> b'\\xc0\\xa8\\x01\\x01'\n        try:\n            self.src_bytes = socket.inet_aton(src_ip)\n\
      \            self.dest_bytes = socket.inet_aton(dest_ip)\n        except OSError:\n\
      \            print(f\"[Error] Invalid IP Address format: {src_ip} or {dest_ip}\"\
      )\n            self.src_bytes = b'\\x00\\x00\\x00\\x00'\n            self.dest_bytes\
      \ = b'\\x00\\x00\\x00\\x00'\n\n        self.TYPE_DATA = 0  # Type 0 = Data Message\n\
      \n        # Register Ports\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\
      \        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\n \
      \   def handle_msg(self, msg):\n        if not pmt.is_pdu(msg):\n          \
      \  return\n\n        meta = pmt.car(msg)\n        data_pdu = pmt.cdr(msg)\n\
      \        data_bytes = bytearray(pmt.u8vector_elements(data_pdu))\n\n       \
      \ # Create Header\n        # Structure: [ Dest (4B) ] [ Src (4B) ] [ TYPE (1B)\
      \ ]\n        # '4s' means a string of 4 bytes. 'B' means 1 unsigned byte.\n\
      \        header = struct.pack('!4s4sB', self.dest_bytes, self.src_bytes, self.TYPE_DATA)\n\
      \n        # Prepend Header to Data\n        # Result: [Dest 4B] [Src 4B] [Type=0]\
      \ [Seq Num] [Payload]\n        new_data = header + data_bytes\n\n        # Publish\n\
      \        out_vector = pmt.init_u8vector(len(new_data), list(new_data))\n   \
      \     out_msg = pmt.cons(meta, out_vector)\n        self.message_port_pub(pmt.intern(\"\
      pdu_out\"), out_msg)"
    affinity: ''
    alias: ''
    comment: ''
    dest_ip: '"192.168.1.20"'
    maxoutbuf: '0'
    minoutbuf: '0'
    src_ip: '"192.168.1.10"'
  states:
    _io_cache: '(''PDU Add Addressing'', ''pdu_add_addressing'', [(''src_ip'', "''192.168.1.10''"),
      (''dest_ip'', "''192.168.1.20''")], [(''pdu_in'', ''message'', 1)], [(''pdu_out'',
      ''message'', 1)], ''\n        Args:\n            src_ip: Source IP Address (String,
      e.g., "192.168.1.10")\n            dest_ip: Destination IP Address (String)\n        '',
