- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass AckNackGenerator(gr.basic_block):\n\
      \    \"\"\"\n    Simple ACK/NACK Generator.\n    - Receives messages on \"ok_in\"\
      \ or \"fail_in\".\n    - Outputs \"ack\" or \"nack\" symbols on \"out\".\n \
      \   Compatible with PDUFileSource's ctrl_in port.\n    \"\"\"\n\n    def __init__(self):\n\
      \        gr.basic_block.__init__(self, name=\"ACK/NACK Generator\", in_sig=[],\
      \ out_sig=[])\n\n        # Input ports\n        self.message_port_register_in(pmt.intern(\"\
      ok_in\"))\n        self.set_msg_handler(pmt.intern(\"ok_in\"), self.handle_ok)\n\
      \n        self.message_port_register_in(pmt.intern(\"fail_in\"))\n        self.set_msg_handler(pmt.intern(\"\
      fail_in\"), self.handle_fail)\n\n        # Output port (to file source ctrl_in)\n\
      \        self.message_port_register_out(pmt.intern(\"out\"))\n\n    def handle_ok(self,\
      \ msg):\n        print(f\"[ACK/NACK] Sending ACK\")\n        self.message_port_pub(pmt.intern(\"\
      out\"), pmt.intern(\"ack\"))\n\n    def handle_fail(self, msg):\n        print(f\"\
      [ACK/NACK] Sending NACK\")\n        self.message_port_pub(pmt.intern(\"out\"\
      ), pmt.intern(\"nack\"))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('ACK/NACK Generator', 'AckNackGenerator', [], [('fail_in', 'message',
      1), ('ok_in', 'message', 1)], [('out', 'message', 1)], '\n    Simple ACK/NACK
      Generator.\n    - Receives messages on "ok_in" or "fail_in".\n    - Outputs
      "ack" or "nack" symbols on "out".\n    Compatible with PDUFileSource\'s ctrl_in
      port.\n    ', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1304, 432.0]
    rotation: 180
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import pmt\nfrom gnuradio import gr\n\nclass TaggedStreamToFile(gr.basic_block):\n\
      \    \"\"\"\n    Writes incoming PDUs (Tagged Stream converted to PDU) into\
      \ a file,\n    including metadata. Appends all incoming PDUs sequentially.\n\
      \    \"\"\"\n\n    def __init__(self, filename=\"C:/Users/arosh/OneDrive/Desktop/output.txt\"\
      ):\n        gr.basic_block.__init__(\n            self,\n            name=\"\
      TaggedStreamToFile\",\n            in_sig=[],\n            out_sig=[]\n    \
      \    )\n        self.filename = filename\n\n        # Register message input\
      \ port\n        self.message_port_register_in(pmt.intern(\"in\"))\n        self.set_msg_handler(pmt.intern(\"\
      in\"), self.handle_msg)\n\n    def handle_msg(self, msg):\n        # msg is\
      \ a PDU = (metadata dict, data vector)\n        meta = pmt.car(msg)        #\
      \ metadata dictionary\n        data = pmt.cdr(msg)        # u8vector payload\n\
      \n        # Convert data to Python bytes\n        data_bytes = bytes(pmt.u8vector_elements(data))\n\
      \n        # Convert metadata to string\n        try:\n            meta_str =\
      \ pmt.write_string(meta)\n        except:\n            meta_str = str(meta)\n\
      \n        # Append to file\n        with open(self.filename, \"ab\") as f:\n\
      \            f.write(b\"==== NEW PACKET ====\\n\")\n            f.write(f\"\
      Metadata: {meta_str}\\n\".encode())\n            f.write(b\"Payload: \" + data_bytes\
      \ + b\"\\n\\n\")\n"
    affinity: ''
    alias: ''
    comment: ''
    filename: r"C:\Users\PC\University\Semester_3\EN2130_Communication Design Project\Project\apple2.txt"
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('TaggedStreamToFile', 'TaggedStreamToFile', [('filename', "'C:/Users/arosh/OneDrive/Desktop/output.txt'")],
      [('in', 'message', 1)], [], '\n    Writes incoming PDUs (Tagged Stream converted
      to PDU) into a file,\n    including metadata. Appends all incoming PDUs sequentially.\n    ',
      ['filename'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1704, 736.0]
    rotation: 0
    state: enabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\npdu_file_source.py\n\
      \nRead a text/binary file, split it into fixed-size PDUs (packets),\npad the\
      \ last packet if needed, and publish them on demand.\n\nFeatures:\n- First PDU\
      \ is sent automatically at start.\n- Waits for \"ack\"/\"nack\" messages:\n\
      \    * \"ack\"  \u2192 send next PDU\n    * \"nack\" \u2192 resend current PDU\
      \ (up to max_retries)\n- Timeout-based automatic retransmission.\n\nAuthor:\
      \ <your name>\n\"\"\"\n\nimport os\nimport threading\nfrom gnuradio import gr\n\
      import pmt\n\n\nclass PDUFileSource(gr.basic_block):\n    \"\"\"\n    GNU Radio\
      \ block: reads a file, splits into PDUs with padding,\n    sends them with ACK/NACK\
      \ + timeout/retries.\n    \"\"\"\n\n    def __init__(self, file_path=\"\", chunk_size=252,\
      \ max_retries=3, timeout_sec=1.0):\n        gr.basic_block.__init__(\n     \
      \       self,\n            name=\"PDU File Source\",\n            in_sig=[],\n\
      \            out_sig=[]\n        )\n\n        self.file_path = file_path\n \
      \       self.chunk_size = chunk_size\n        self.max_retries = max_retries\n\
      \        self.timeout_sec = timeout_sec\n\n        self.pdus = []\n        self.index\
      \ = 0\n        self.retry_count = 0\n\n        self._lock = threading.Lock()\n\
      \        self._timer_thread = None\n        self._timer_event = threading.Event()\n\
      \n        self._load_and_pad_file()\n\n        # Output (PDU) port\n       \
      \ self.message_port_register_out(pmt.intern(\"pdus_out\"))\n\n        # Input\
      \ (control) port for ack/nack\n        self.message_port_register_in(pmt.intern(\"\
      ctrl_in\"))\n        self.set_msg_handler(pmt.intern(\"ctrl_in\"), self._handle_ack_nack)\n\
      \n        print(f\"[INFO] PDUFileSource initialized. \"\n              f\"{len(self.pdus)}\
      \ PDUs loaded. \"\n              f\"max_retries={self.max_retries}, timeout={self.timeout_sec}s\"\
      )\n\n    # ---------------------------------------------------------------------\n\
      \    # GNU Radio lifecycle\n    # ---------------------------------------------------------------------\n\
      \    def start(self):\n        if self.pdus:\n            print(\"[INFO] Sending\
      \ first PDU on start\")\n            self._send_current_pdu()\n        return\
      \ True\n\n    # ---------------------------------------------------------------------\n\
      \    # Internal helpers\n    # ---------------------------------------------------------------------\n\
      \    def _load_and_pad_file(self):\n        if not os.path.exists(self.file_path):\n\
      \            print(f\"[ERROR] File not found: {self.file_path}\")\n        \
      \    return\n\n        with open(self.file_path, \"rb\") as f:\n           \
      \ data = f.read()\n\n        self.pdus = []\n        for i in range(0, len(data),\
      \ self.chunk_size):\n            chunk = data[i:i + self.chunk_size]\n     \
      \       if len(chunk) < self.chunk_size:\n                # pad with spaces\
      \ (0x20) if last chunk is short\n                chunk += b' ' * (self.chunk_size\
      \ - len(chunk))\n            self.pdus.append(chunk)\n\n        print(f\"[INFO]\
      \ Loaded and padded {len(self.pdus)} PDUs \"\n              f\"from file '{self.file_path}'.\"\
      )\n\n    def _send_current_pdu(self):\n        if 0 <= self.index < len(self.pdus):\n\
      \            pdu = self.pdus[self.index]\n            print(f\"[DEBUG] Sending\
      \ PDU {self.index} (size {len(pdu)}) \"\n                  f\"[retry={self.retry_count}]\"\
      )\n            pmt_pdu = pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(pdu), list(pdu)))\n\
      \            self.message_port_pub(pmt.intern(\"pdus_out\"), pmt_pdu)\n    \
      \        self._start_timer()\n        else:\n            print(\"[INFO] No more\
      \ PDUs to send.\")\n\n    def _start_timer(self):\n        # stop any old timer\n\
      \        if self._timer_thread and self._timer_thread.is_alive():\n        \
      \    self._timer_event.set()\n            if threading.current_thread() != self._timer_thread:\n\
      \                self._timer_thread.join()\n\n        self._timer_event.clear()\n\
      \        self._timer_thread = threading.Thread(target=self._timeout_handler,\
      \ daemon=True)\n        self._timer_thread.start()\n\n    def _timeout_handler(self):\n\
      \        if not self._timer_event.wait(self.timeout_sec):\n            with\
      \ self._lock:\n                if self.retry_count < self.max_retries:\n   \
      \                 self.retry_count += 1\n                    print(f\"[DEBUG]\
      \ Timeout: resending PDU {self.index} \"\n                          f\"(retry\
      \ {self.retry_count}/{self.max_retries})\")\n                    self._send_current_pdu()\n\
      \                else:\n                    print(f\"[WARNING] Max retries reached\
      \ for PDU {self.index}. \"\n                          \"Skipping to next.\"\
      )\n                    self.index += 1\n                    self.retry_count\
      \ = 0\n                    if self.index < len(self.pdus):\n               \
      \         self._send_current_pdu()\n                    else:\n            \
      \            print(\"[INFO] All PDUs sent. Done.\")\n\n    def _handle_ack_nack(self,\
      \ msg_pmt):\n        if not pmt.is_symbol(msg_pmt):\n            print(\"[WARNING]\
      \ Invalid control message format. Ignored.\")\n            return\n\n      \
      \  command = pmt.symbol_to_string(msg_pmt).lower()\n\n        with self._lock:\n\
      \            # stop timer\n            if self._timer_thread and self._timer_thread.is_alive():\n\
      \                self._timer_event.set()\n                if threading.current_thread()\
      \ != self._timer_thread:\n                    self._timer_thread.join()\n\n\
      \            if command == \"ack\":\n                self.index += 1\n     \
      \           self.retry_count = 0\n                if self.index < len(self.pdus):\n\
      \                    self._send_current_pdu()\n                else:\n     \
      \               print(\"[INFO] All PDUs sent. Done.\")\n            elif command\
      \ == \"nack\":\n                if self.retry_count < self.max_retries:\n  \
      \                  self.retry_count += 1\n                    print(f\"[DEBUG]\
      \ NACK received: resending PDU {self.index} \"\n                          f\"\
      (retry {self.retry_count}/{self.max_retries})\")\n                    self._send_current_pdu()\n\
      \                else:\n                    print(f\"[WARNING] Max retries reached\
      \ for PDU {self.index}. \"\n                          \"Skipping to next.\"\
      )\n                    self.index += 1\n                    self.retry_count\
      \ = 0\n                    if self.index < len(self.pdus):\n               \
      \         self._send_current_pdu()\n                    else:\n            \
      \            print(\"[INFO] All PDUs sent. Done.\")\n            else:\n   \
      \             print(f\"[WARNING] Unknown control command: {command}\")\n\n\n\
      # -------------------------------------------------------------------------\n\
      # Example (stand-alone) usage:\n# -------------------------------------------------------------------------\n\
      if __name__ == \"__main__\":\n    import sys\n\n    if len(sys.argv) < 2:\n\
      \        print(\"Usage: python3 pdu_file_source.py <input-file> [chunk_size]\"\
      )\n        sys.exit(1)\n\n    path = sys.argv[1]\n    size = int(sys.argv[2])\
      \ if len(sys.argv) > 2 else 252\n\n    blk = PDUFileSource(file_path=path, chunk_size=size)\n\
      \    # In a real flowgraph, GNU Radio calls start() for you.\n    blk.start()\n"
    affinity: ''
