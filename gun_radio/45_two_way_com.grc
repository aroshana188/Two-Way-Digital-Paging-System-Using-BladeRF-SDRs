      \ [Seq Num] [Payload]\n        new_data = header + data_bytes\n\n        # Publish\n\
      \        out_vector = pmt.init_u8vector(len(new_data), list(new_data))\n   \
      \     out_msg = pmt.cons(meta, out_vector)\n        self.message_port_pub(pmt.intern(\"\
