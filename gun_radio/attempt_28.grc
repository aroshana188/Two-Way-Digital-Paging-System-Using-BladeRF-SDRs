- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ time\n\nclass crc_fail_logger(gr.basic_block):\n    def __init__(self, log_file=''):\n\
      \        gr.basic_block.__init__(self,\n            name=\"CRC Fail Logger\"\
      ,\n            in_sig=None,\n            out_sig=None)\n\n        # INPUT: Connect\
      \ this to the 'fail' port of the CRC Check block\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \        \n        self.fail_count = 0\n        \n        # LOGGING SETUP\n\
      \        self.log_file_path = log_file\n        if self.log_file_path != '':\n\
      \            try:\n                with open(self.log_file_path, 'w') as f:\n\
      \                    f.write(\"--- CRC FAILURE LOG START ---\\n\")\n       \
      \     except: pass\n\n    def log(self, message):\n        \"\"\"Helper function\
      \ to Print AND Write to file\"\"\"\n        print(message)\n        if self.log_file_path\
      \ != '':\n            try:\n                with open(self.log_file_path, 'a')\
      \ as f:\n                    timestamp = time.strftime(\"%H:%M:%S\", time.localtime())\n\
      \                    f.write(f\"[{timestamp}] {message}\\n\")\n            except:\
      \ pass\n\n    def handle_msg(self, msg):\n        try:\n            self.fail_count\
      \ += 1\n            \n            # Extract the length of the bad packet just\
      \ for info\n            payload = pmt.cdr(msg)\n            data_len = len(pmt.u8vector_elements(payload))\n\
      \            \n            self.log(f\"[CRC FAIL] Corrupted Packet Dropped!\
      \ (Size: {data_len} bytes | Total Fails: {self.fail_count})\")\n           \
      \ \n        except Exception as e:\n            self.log(f\"[CRC Log Error]\
      \ {e}\")"
    affinity: ''
    alias: ''
    comment: ''
    log_file: '"C:/Users/PC/Desktop/Receiver log.txt"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('CRC Fail Logger', 'crc_fail_logger', [('log_file', "''")], [('pdu_in',
      'message', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4064, 720.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\nimport\
      \ time\nimport threading\nimport os\n\nclass pdu_storage_buffer(gr.basic_block):\n\
      \    def __init__(self, timeout=1.0, max_retries=5, log_file=''):\n        gr.basic_block.__init__(self,\n\
      \            name=\"PDU Storage\",\n            in_sig=None,\n            out_sig=None)\n\
      \n        # PORTS\n        self.message_port_register_in(pmt.intern(\"pdu_in\"\
      ))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_incoming_pdu)\n\
      \n        self.message_port_register_in(pmt.intern(\"request_in\"))\n      \
      \  self.set_msg_handler(pmt.intern(\"request_in\"), self.handle_request)\n\n\
      \        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\n       \
      \ # STORAGE & STATE\n        self.pdu_storage = {}\n        self.in_preamble_phase\
      \ = True\n        \n        # TIMEOUT PARAMETERS\n        self.timeout = timeout\n\
      \        self.max_retries = max_retries\n        \n        # TIMEOUT STATE\n\
      \        self.current_seq_waiting = 0 \n        self.retry_count = 0\n     \
      \   self.last_tx_time = time.time()\n        \n        # LOGGING SETUP\n   \
      \     self.log_file_path = log_file\n        if self.log_file_path != '':\n\
      \            try:\n                with open(self.log_file_path, 'w') as f:\n\
      \                    f.write(\"--- ARQ STORAGE LOG START ---\\n\")\n       \
      \     except: pass\n        \n        # THREADING\n        self.stop_thread\
      \ = False\n        self.thread = threading.Thread(target=self.timer_loop)\n\
      \        self.thread.daemon = True\n\n    def start(self):\n        self.stop_thread\
      \ = False\n        self.thread.start()\n        return True\n\n    def stop(self):\n\
      \        self.stop_thread = True\n        self.thread.join()\n        return\
      \ True\n\n    def log(self, message):\n        print(message)\n        if self.log_file_path\
      \ != '':\n            try:\n                with open(self.log_file_path, 'a')\
      \ as f:\n                    timestamp = time.strftime(\"%H:%M:%S\", time.localtime())\n\
      \                    f.write(f\"[{timestamp}] {message}\\n\")\n            except:\
      \ pass\n\n    def handle_incoming_pdu(self, msg):\n        try:\n          \
      \  payload = pmt.cdr(msg)\n            data = pmt.u8vector_elements(payload)\n\
      \            if len(data) < 1: return\n            seq_num = data[0]\n     \
      \       \n            # Store PDU\n            self.pdu_storage[seq_num] = msg\n\
      \n            # PREAMBLE LOGIC\n            if self.in_preamble_phase:\n   \
      \             self.log(f\"[PDU Storage Buffer]        Preamble/Init #{seq_num}\
      \ sending.\")\n                self.message_port_pub(pmt.intern(\"pdu_out\"\
      ), msg)\n                \n                if seq_num == 0:\n              \
      \      self.in_preamble_phase = False\n                    self.current_seq_waiting\
      \ = 0\n                    self.reset_timer()\n\n        except Exception as\
      \ e:\n            self.log(f\"[PDU Storage Error] Store: {e}\")\n\n    def handle_request(self,\
      \ msg):\n        try:\n            payload = pmt.cdr(msg)\n            data\
      \ = pmt.u8vector_elements(payload)\n            if len(data) < 1: return\n \
      \           \n            req_seq = data[0]\n\n            # --- FIX: GHOST\
      \ ACK PROTECTION ---\n            diff = (req_seq - self.current_seq_waiting\
      \ + 256) % 256\n            \n            if diff > 128:\n                self.log(f\"\
      [PDU Storage Ignore]      Ignoring old request for #{req_seq} (I am at #{self.current_seq_waiting})\"\
      )\n                return\n            # --------------------------------\n\n\
      \            # UPDATE STATE\n            if req_seq != self.current_seq_waiting:\n\
      \                self.log(f\"[PDU Storage Buffer]        ACK received! Moving\
      \ target to #{req_seq}\")\n                self.current_seq_waiting = req_seq\n\
      \                self.reset_timer() \n                \n                # ---\
      \ COMPLETION CHECK ---\n                # If we moved to a sequence number we\
      \ don't have yet, \n                # it means we finished everything currently\
      \ in the buffer.\n                if self.current_seq_waiting not in self.pdu_storage:\n\
      \                    self.log(f\"[PDU Storage Info] All packets sent & ACKed.\
      \ Transmission Complete.\")\n\n            # SEND IMMEDIATELY\n            if\
      \ req_seq in self.pdu_storage:\n                self.send_pdu(req_seq)\n   \
      \         else:\n                pass\n\n        except Exception as e:\n  \
      \          self.log(f\"[PDU Storage Error] Request: {e}\")\n\n    def send_pdu(self,\
      \ seq_num):\n        if seq_num in self.pdu_storage:\n            self.message_port_pub(pmt.intern(\"\
      pdu_out\"), self.pdu_storage[seq_num])\n            self.last_tx_time = time.time()\
      \ \n\n    def reset_timer(self):\n        self.retry_count = 0\n        self.last_tx_time\
      \ = time.time()\n\n    def timer_loop(self):\n        time.sleep(2.0)\n    \
      \    \n        while not self.stop_thread:\n            time.sleep(0.1) \n \
      \           \n            if self.in_preamble_phase:\n                continue\n\
      \n            now = time.time()\n            if (now - self.last_tx_time) >\
      \ self.timeout:\n                \n                if self.retry_count < self.max_retries:\n\
      \                    if self.current_seq_waiting in self.pdu_storage:\n    \
      \                    self.log(f\"[PDU Storage Timeout]       Resending #{self.current_seq_waiting}\
      \ (Attempt {self.retry_count + 1}/{self.max_retries})\")\n                 \
      \       self.send_pdu(self.current_seq_waiting)\n                        self.retry_count\
      \ += 1\n                    else:\n                        self.last_tx_time\
      \ = time.time()\n                        \n                else:\n         \
      \           # MAX RETRIES REACHED -> SKIP\n                    self.log(f\"\
      [PDU Storage Skip]          Max retries failed for #{self.current_seq_waiting}.\
      \ Skipping.\")\n                    \n                    # Move to next sequence\
      \ number\n                    self.current_seq_waiting = (self.current_seq_waiting\
      \ + 1) % 256\n                    \n                    # Reset retries for\
      \ the NEW target\n                    self.retry_count = 0\n               \
      \     \n                    # Send immediate update\n                    if\
      \ self.current_seq_waiting in self.pdu_storage:\n                        self.log(f\"\
      [PDU Storage Skip]          Sending new target #{self.current_seq_waiting}\"\
      )\n                        self.send_pdu(self.current_seq_waiting)\n       \
      \             else:\n                        self.last_tx_time = time.time()\n\
      \                        # --- COMPLETION CHECK (ON SKIP) ---\n            \
      \            self.log(f\"[PDU Storage Info] Skipped to end. Transmission Complete\
      \ (Buffer Empty).\")"
    affinity: ''
    alias: ''
    comment: ''
    log_file: '"C:/Users/PC/Desktop/Transmitter log.txt"'
    max_retries: '5'
    maxoutbuf: '0'
    minoutbuf: '0'
    timeout: '1'
  states:
    _io_cache: ('PDU Storage', 'pdu_storage_buffer', [('timeout', '1.0'), ('max_retries',
      '5'), ('log_file', "''")], [('pdu_in', 'message', 1), ('request_in', 'message',
      1)], [('pdu_out', 'message', 1)], '', ['max_retries', 'timeout'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 212.0]
    rotation: 0
    state: enabled
- name: epy_block_10
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ dest_addr_check(gr.basic_block):\n    def __init__(self, my_address=20):\n\
      \        gr.basic_block.__init__(self,\n            name=\"Destination Address\
      \ Filter\",\n            in_sig=None,\n            out_sig=None)\n\n       \
      \ # 1. Register Input (From CRC Block)\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \n        # 2. Register Output (To ARQ/Decoder Block)\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n        # 3. Store My Address\n        self.my_addr = my_address\n\
      \n    def handle_msg(self, msg):\n        try:\n            # Extract data from\
      \ PDU\n            payload_pmt = pmt.cdr(msg)\n            data_list = pmt.u8vector_elements(payload_pmt)\n\
      \            \n            # Safety Check: Packet must be at least 2 bytes (SRC\
      \ + DST)\n            if len(data_list) < 2:\n                return\n\n   \
      \         # --- ADDRESS LOGIC ---\n            # Based on your structure: Byte\
      \ 0 = SRC, Byte 1 = DST\n            packet_dst = data_list[1] \n\n        \
      \    # Compare\n            if packet_dst == self.my_addr:\n               \
      \ # MATCH: Valid packet for me.\n                # Pass the WHOLE frame (header\
      \ + payload) to the next block.\n                self.message_port_pub(pmt.intern(\"\
      pdu_out\"), msg)\n            else:\n                # MISMATCH: Packet is for\
      \ someone else.\n                # Drop it silently (or print for debug)\n \
      \               # print(f\"Dropped packet for User #{packet_dst}\")\n      \
      \          pass\n\n        except Exception as e:\n            print(f\"[Addr\
      \ Check Error] {e}\")"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_address: '20'
  states:
    _io_cache: ('Destination Address Filter', 'dest_addr_check', [('my_address', '20')],
      [('pdu_in', 'message', 1)], [('pdu_out', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [4064, 632.0]
    rotation: 0
    state: enabled
- name: epy_block_10_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass\
      \ dest_addr_check(gr.basic_block):\n    def __init__(self, my_address=20):\n\
      \        gr.basic_block.__init__(self,\n            name=\"Destination Address\
      \ Filter\",\n            in_sig=None,\n            out_sig=None)\n\n       \
      \ # 1. Register Input (From CRC Block)\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \n        # 2. Register Output (To ARQ/Decoder Block)\n        self.message_port_register_out(pmt.intern(\"\
      pdu_out\"))\n\n        # 3. Store My Address\n        self.my_addr = my_address\n\
      \n    def handle_msg(self, msg):\n        try:\n            # Extract data from\
      \ PDU\n            payload_pmt = pmt.cdr(msg)\n            data_list = pmt.u8vector_elements(payload_pmt)\n\
      \            \n            # Safety Check: Packet must be at least 2 bytes (SRC\
      \ + DST)\n            if len(data_list) < 2:\n                return\n\n   \
      \         # --- ADDRESS LOGIC ---\n            # Based on your structure: Byte\
      \ 0 = SRC, Byte 1 = DST\n            packet_dst = data_list[1] \n\n        \
      \    # Compare\n            if packet_dst == self.my_addr:\n               \
      \ # MATCH: Valid packet for me.\n                # Pass the WHOLE frame (header\
      \ + payload) to the next block.\n                self.message_port_pub(pmt.intern(\"\
      pdu_out\"), msg)\n            else:\n                # MISMATCH: Packet is for\
      \ someone else.\n                # Drop it silently (or print for debug)\n \
      \               # print(f\"Dropped packet for User #{packet_dst}\")\n      \
      \          pass\n\n        except Exception as e:\n            print(f\"[Addr\
      \ Check Error] {e}\")"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    my_address: '20'
  states:
