- name: epy_block_11_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: PDU Head Stripper\n\"\"\"\n\nimport\
      \ numpy as np\nfrom gnuradio import gr\nimport pmt\n\nclass pdu_head_stripper(gr.basic_block):\n\
      \    def __init__(self, strip_bytes=20):\n        \"\"\"\n        Args:\n  \
      \          strip_bytes: Number of bytes to remove from the beginning of the\
      \ packet.\n        \"\"\"\n        gr.basic_block.__init__(self,\n         \
      \   name=\"PDU Head Stripper\",\n            in_sig=None,\n            out_sig=None)\n\
      \n        self.n_strip = strip_bytes\n\n        # Register Ports\n        self.message_port_register_in(pmt.intern(\"\
      pdu_in\"))\n        self.message_port_register_out(pmt.intern(\"pdu_out\"))\n\
      \        \n        self.set_msg_handler(pmt.intern(\"pdu_in\"), self.handle_msg)\n\
      \n    def handle_msg(self, msg):\n        # 1. Validate Input\n        if not\
      \ pmt.is_pdu(msg):\n            return\n\n        # 2. Extract Data\n      \
      \  meta = pmt.car(msg)\n        data_pdu = pmt.cdr(msg)\n        data_bytes\
      \ = pmt.u8vector_elements(data_pdu)\n        \n        # 3. Safety Check\n \
      \       # If packet is smaller than what we want to strip, drop it.\n      \
      \  if len(data_bytes) <= self.n_strip:\n            return\n\n        # 4. Strip\
      \ the Head\n        # We take everything starting from index 'n_strip' to the\
      \ end\n        clean_data = data_bytes[self.n_strip:]\n        \n        # 5.\
      \ Pack and Publish\n        out_vector = pmt.init_u8vector(len(clean_data),\
      \ clean_data)\n        out_msg = pmt.cons(meta, out_vector)\n        \n    \
      \    self.message_port_pub(pmt.intern(\"pdu_out\"), out_msg)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    strip_bytes: '3200'
