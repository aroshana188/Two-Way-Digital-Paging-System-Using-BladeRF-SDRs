    bus_structure: null
    coordinate: [2256, 248.0]
    rotation: 0
    state: disabled
- name: epy_block_2_1
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Block: Selective AES (Skip 9 Bytes)\nSkips\
      \ [Src(4)+Dst(4)+SN(1)] and encrypts the rest.\n\"\"\"\nimport numpy as np\n\
      from gnuradio import gr\nimport pmt\nfrom Crypto.Cipher import AES\n\nclass\
      \ SelectiveAES(gr.basic_block):\n    def __init__(self, key_str=\"1234567890123456\"\
      ):\n        gr.basic_block.__init__(self,\n            name=\"Selective AES\
      \ (Skip 9B)\",\n            in_sig=None,\n            out_sig=None)\n      \
      \  \n        self.key = key_str.encode('utf-8')[:16]\n        while len(self.key)\
      \ < 16:\n            self.key += b'\\0'\n            \n        self.message_port_register_in(pmt.intern(\"\
      in\"))\n        self.message_port_register_out(pmt.intern(\"out\"))\n      \
      \  self.set_msg_handler(pmt.intern(\"in\"), self.handle_msg)\n\n    def handle_msg(self,\
      \ msg):\n        payload_pmt = pmt.cdr(msg)\n        data = list(pmt.u8vector_elements(payload_pmt))\n\
      \        \n        # Safety Check: Header(9) + Min AES Block(16) = 25 bytes\
      \ min\n        if len(data) < 25: \n            return\n\n        # 1. Separate\
      \ Header (Clear) and Payload (To Encrypt)\n        # Splitting at byte 9\n \
      \       header = data[0:9]      # Src(4) + Dst(4) + SN(1)\n        payload =\
      \ data[9:]      # Msg + Pad\n        \n        # 2. Encrypt Payload\n      \
      \  try:\n            cipher = AES.new(self.key, AES.MODE_ECB)\n            encrypted_bytes\
      \ = cipher.encrypt(bytes(payload))\n        except ValueError as e:\n      \
      \      print(f\"[AES] Error: Payload len {len(payload)} not multiple of 16.\"\
      )\n            return\n        \n        # 3. Re-combine\n        final_packet\
      \ = header + list(encrypted_bytes)\n        \n        # 4. Output\n        out_pdu\
      \ = pmt.init_u8vector(len(final_packet), final_packet)\n        out_msg = pmt.cons(pmt.PMT_NIL,\
      \ out_pdu)\n        self.message_port_pub(pmt.intern(\"out\"), out_msg)"
